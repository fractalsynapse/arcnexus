{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmitOnError": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules", "context", "examples"]
}
