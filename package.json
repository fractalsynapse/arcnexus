{
  "name": "arcnexus",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cordis": "4.0.0-rc.13",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/clean-build.ts && tsc",
    "check": "tsc --noEmit",
    "check:specification": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/check-specification.ts",
    "lint": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/owner-quality.ts lint",
    "lint:fix": "eslint --fix --pass-on-no-patterns",
    "format:check": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/owner-quality.ts format:check",
    "format": "prettier --write",
    "test": "npm run build && node dist/packages/foundation/scripts/test.js"
  },
  "bin": {
    "arcnexus": "dist/apps/cli/src/index.js"
  }
}
