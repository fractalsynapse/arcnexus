{
  "name": "arcnexus",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@mdxeditor/editor": "4.5.0",
    "@mdxeditor/gurx": "1.2.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "highlight.js": "11.12.0",
    "jiti": "2.7.0",
    "marked": "18.2.1",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@octokit/auth-app": "8.3.1",
    "cordis": "4.0.0-rc.13",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/clean-build.ts && tsc && node dist/apps/web/build.js",
    "check": "tsc --noEmit",
    "check:specification": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/check-specification.ts",
    "lint": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/owner-quality.ts lint",
    "lint:fix": "eslint --fix --pass-on-no-patterns",
    "format:check": "JITI_FS_CACHE=0 jiti packages/foundation/scripts/owner-quality.ts format:check",
    "format": "prettier --write",
    "test": "npm run build && node dist/packages/foundation/scripts/test.js",
    "web": "node dist/apps/web/src/serve-local.js"
  },
  "bin": {
    "arcnexus": "dist/apps/cli/src/index.js"
  }
}
