{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/role-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [4]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "activity": {
      "enum": ["research", "documentation", "testing", "implementation", "review", "release"]
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "executionProfile": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["schemaVersion", "id", "purpose", "activity", "responsibilities"],
  "additionalProperties": false
}
