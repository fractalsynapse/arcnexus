{
  "type": "object",
  "properties": {
    "status": {
      "enum": ["completed", "blocked", "failed"],
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["summary", "evidence", "uncertainty"],
        "additionalProperties": false
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity": {
            "enum": ["research", "documentation", "testing", "implementation", "review", "release"],
            "type": "string"
          },
          "status": {
            "enum": ["completed", "skipped", "blocked"],
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["activity", "status", "summary", "sources"],
        "additionalProperties": false
      }
    },
    "regression": {
      "$ref": "https://arcnexus.local/schemas/regression-expectation-v1"
    },
    "reviewFindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromComponent": {
            "type": "string",
            "minLength": 1
          },
          "ownerId": {
            "type": ["string", "null"]
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Describe caller-specific acceptance for new work. When assignmentId links existing supplier work, use [] instead of copying or changing the supplier's canonical accepted criteria."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "assignmentId": {
            "description": "Use null for distinct new recipient work. A non-null ID deliberately links an existing recipient assignment in this run; its canonical accepted objective, criteria, owner, and workflow govern, and requester text cannot rewrite or expand them. Never use a tracking issue ID, request/message ID, or your own assignment ID.",
            "type": ["string", "null"]
          },
          "milestone": {
            "enum": ["delivered", "accepted"],
            "description": "Use delivered for code, tests, documentation or other verified artifacts. Accepted means intent only."
          },
          "kind": {
            "enum": ["change", "research", "review", null]
          },
          "changeType": {
            "enum": ["behavior", "documentation", "refactor", null]
          }
        },
        "required": [
          "fromComponent",
          "ownerId",
          "request",
          "evidence",
          "acceptanceCriteria",
          "reason",
          "assignmentId",
          "milestone",
          "kind",
          "changeType"
        ],
        "additionalProperties": false
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approach": {
              "type": "string",
              "minLength": 1
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "activities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "activity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["activity", "reason"]
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "status": {
                    "enum": ["pending", "in_progress", "completed", "skipped", "blocked"]
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "activity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "expectedEvidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "status",
                  "explanation",
                  "evidence",
                  "activity",
                  "result",
                  "criteria",
                  "expectedEvidence",
                  "dependencies"
                ]
              }
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["approach", "assumptions", "activities", "items", "questions"]
        }
      ]
    },
    "planUpdates": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "status": {
            "enum": ["pending", "in_progress", "completed", "skipped", "blocked"]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["id", "status", "explanation", "evidence"]
      }
    },
    "inboxActions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "action": {
            "enum": ["accept", "reject", "clarify", "answer", "require_delivery", "feedback"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["requestId", "action", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "blockers",
    "findings",
    "activities",
    "regression",
    "reviewFindings",
    "requests"
  ],
  "additionalProperties": false,
  "$id": "https://arcnexus.local/schemas/general-agent-result-v1"
}
